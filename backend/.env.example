
PORT=9007
HOST=0.0.0.0


ARK_API_KEY="api_key"
ARK_BASE_URL="api_url"
MODEL_EP="model"


REDIS_URL="redis://localhost:6375/0"
DATABASE_URL="sqlite:///./agenthub.db"


SANDBOX_IMAGE="python:3.11-slim"
SANDBOX_NETWORK="bridge"
SANDBOX_ALLOW_NETWORK=true
SANDBOX_AUTO_INSTALL_UV=true
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_COMMAND_TIMEOUT_SECONDS=120
SANDBOX_SETUP_TIMEOUT_SECONDS=300
SANDBOX_MAX_PARALLEL_STEPS=1
SANDBOX_WORKSPACE_ROOT="/tmp/agenthub-sandboxes"
SANDBOX_MAX_OUTPUT_CHARS=100000
SANDBOX_MAX_OUTPUT_BYTES=100000
SANDBOX_MAX_TOOL_ITERATIONS=8
SANDBOX_AUTO_RETRY_ENABLED=true
SANDBOX_AUTO_RETRY_MAX_ATTEMPTS=5
SANDBOX_KEEP_WORKSPACE_ON_STATUSES="failed,conflict,cancelled"
SANDBOX_CLEANUP_COMPLETED_WORKSPACE=true
SANDBOX_WORKSPACE_SCAN_MAX_FILES=500
SANDBOX_WORKSPACE_FILE_MAX_BYTES=200000
SANDBOX_CPUS="1.0"
SANDBOX_MEMORY="512m"
SANDBOX_PIDS_LIMIT=128
SANDBOX_RUN_AS_USER="1000:1000"
SANDBOX_READ_ONLY_ROOTFS=false

WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER="ddgs"
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_CONTEXT_MAX_RESULTS=5
WEB_SEARCH_BODY_MAX_CHARS=500
WEB_SEARCH_QUERY_MAX_CHARS=300
WEB_SEARCH_FETCH_MAX_RESULTS=3
WEB_SEARCH_FETCH_MAX_BYTES=1000000
WEB_SEARCH_PAGE_MAX_CHARS=12000
WEB_SEARCH_CONTEXT_MAX_CHARS=30000
WEB_SEARCH_FETCH_TIMEOUT_SECONDS=8
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_CACHE_TTL_SECONDS=3600
WEB_SEARCH_REGION="wt-wt"
WEB_SEARCH_SAFESEARCH="moderate"

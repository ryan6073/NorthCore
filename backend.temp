agenthub-backend/
├── .env                  # 环境变量配置（切勿提交至 Git）
├── .gitignore            # 忽略文件配置
├── requirements.txt      # 依赖项
├── README.md             # 后端说明文档
└── app/
    ├── __init__.py
    ├── main.py           # 服务启动主入口
    ├── config.py         # Pydantic 统一配置中心（读取 .env）
    ├── database.py       # 数据库连接初始化 (SQL & Vector)
    ├── api/              # HTTP 路由层
    │   ├── __init__.py
    │   ├── auth.py       # 用户认证
    │   ├── chat.py       # 历史聊天记录查询、会话管理
    │   └── agent.py      # 自建 Agent 的 CRUD
    ├── websocket/        # WebSocket 实时交互层
    │   ├── __init__.py
    │   ├── connection.py # 统一连接管理器 (ConnectionManager)
    │   └── handler.py    # 消息分发核心逻辑 (单聊/群聊/状态实时推送)
    ├── core/             # 核心 Agent 调度与记忆引擎
    │   ├── __init__.py
    │   ├── orchestrator.py # 主 Agent 协调器 (任务拆解、并行调度、冲突处理)
    │   ├── adapter.py    # 统一适配器层 (Claude Code / Volcengine / OpenCode)
    │   └── memory.py     # 记忆管理器 (Redis 短期历史结合 Vector 长期检索)
    └── models/           # 数据库 ORM 模型
        ├── __init__.py
        ├── rdb.py        # 关系型数据库模型 (User, Session, Message, Artifact)
        └── vector.py     # 向量数据库 Schemas